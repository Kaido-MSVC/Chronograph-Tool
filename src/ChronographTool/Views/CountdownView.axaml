<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChronographTool.ViewModels"
             x:Class="ChronographTool.Views.CountdownView"
             x:DataType="vm:CountdownViewModel">

  <StackPanel Margin="24,20,24,20" MaxWidth="720" Spacing="16">
    <!-- 時間設定：開始後鎖定，重置後才能修改。 -->
    <Border Classes="panel" Padding="16" IsEnabled="{Binding CanEditDuration}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="設定時間" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <NumericUpDown Value="{Binding Hours}" Minimum="0" Maximum="99" Increment="1" FormatString="0"
                         Width="120" ParsingNumberStyle="Integer" />
          <TextBlock Text="時" VerticalAlignment="Center" Margin="0,0,12,0" />
          <NumericUpDown Value="{Binding Minutes}" Minimum="0" Maximum="59" Increment="1" FormatString="0"
                         Width="120" ParsingNumberStyle="Integer" />
          <TextBlock Text="分" VerticalAlignment="Center" Margin="0,0,12,0" />
          <NumericUpDown Value="{Binding Seconds}" Minimum="0" Maximum="59" Increment="1" FormatString="0"
                         Width="120" ParsingNumberStyle="Integer" />
          <TextBlock Text="秒" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Presets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CountdownPreset">
              <Button Content="{Binding Label}" Margin="0,0,8,0" MinWidth="64" HorizontalContentAlignment="Center"
                      Command="{Binding $parent[ItemsControl].((vm:CountdownViewModel)DataContext).ApplyPresetCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding InputError}" IsVisible="{Binding InputError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{DynamicResource SlowestBrush}" />
      </StackPanel>
    </Border>

    <TextBlock Classes="digits" Text="{Binding Display}" FontSize="64" FontWeight="Light" HorizontalAlignment="Center" />
    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" MaxWidth="480" />

    <!-- 時間到提示 -->
    <Border IsVisible="{Binding IsTimeUp}" Background="{DynamicResource TimeUpBrush}" CornerRadius="8" Padding="16,10"
            HorizontalAlignment="Center" MinWidth="320">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="時間到！已存成一筆紀錄。" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TimeUpTextBrush}" />
        <Button Grid.Column="1" Content="知道了" Margin="16,0,0,0" Command="{Binding DismissTimeUpCommand}" />
      </Grid>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
      <Button Classes="primary accent" Content="{Binding StartPauseText}" Command="{Binding StartPauseCommand}" />
      <Button Classes="secondary" Content="重置" Command="{Binding ResetCommand}" />
    </StackPanel>

    <CheckBox Content="時間到時播放提示音" IsChecked="{Binding SoundEnabled}" HorizontalAlignment="Center" />

    <TextBlock Classes="muted" HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
               Text="快捷鍵：空白鍵 開始／暫停　R 重置。時間到或中途重置都會自動存成紀錄。" />
  </StackPanel>
</UserControl>
