<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <AssemblyName>ChronographTool</AssemblyName>
    <RootNamespace>ChronographTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- LibraryImport（PlaySound、FlashWindowEx、AllowSetForegroundWindow）的產生程式碼需要。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.2.0</Version>
    <Product>Chronograph Tool</Product>
    <AssemblyTitle>Chronograph Tool</AssemblyTitle>
    <!-- 「關於」對話方塊從 AssemblyCopyright／AssemblyInformationalVersion 讀取著作權與版本。 -->
    <Copyright>Copyright © 2026 Kaido-MSVC</Copyright>
  </PropertyGroup>

  <!-- 授權文件：嵌入程式供「關於」對話方塊顯示（發行資料夾內的檔案被刪也能看），
       同時複製到發行資料夾根目錄。使用說明.txt 只放在發行資料夾。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="ChronographTool.LICENSE" Visible="false" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="ChronographTool.THIRD-PARTY-NOTICES.txt" Visible="false" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\packaging\使用說明.txt" Link="使用說明.txt" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChronographTool.Tests" />
    <!-- 視窗標題列與工作列圖示；圖示由 tools/make-icon.ps1 產生。 -->
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- 發行時排除 SkiaSharp／HarfBuzz 原生程式庫附帶的 .pdb（約 105 MB，執行時用不到）；保留本程式自己的 .pdb。 -->
  <Target Name="ExcludeNativePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' And '%(Filename)' != '$(AssemblyName)'" />
    </ItemGroup>
  </Target>
</Project>
